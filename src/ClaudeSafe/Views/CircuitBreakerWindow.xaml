<Window x:Class="ClaudeSafe.Views.CircuitBreakerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource CB_WindowTitle}"
        Icon="pack://application:,,,/Assets/ClaudeSafe.ico"
        Width="440"
        Height="415"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Border Margin="14"
            Padding="22"
            CornerRadius="20"
            Background="#FAF9F5"
            BorderBrush="#E8B4AA"
            BorderThickness="1.5"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.18" Color="#141413"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题区 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="42" Height="42" CornerRadius="21" Background="#FDECE8" Margin="0,0,12,0">
                    <TextBlock Text="🚨" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource CB_Headline}"
                               FontSize="15.5"
                               FontWeight="Bold"
                               Foreground="#B42318"/>
                    <TextBlock x:Name="CountdownSublineText"
                               Text=""
                               FontSize="12"
                               Foreground="#6B6962"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- 触发原因卡片 -->
            <Border Grid.Row="1"
                    Background="#FDECE8"
                    BorderBrush="#F4C7BD"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12"
                    Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource CB_ReasonLabel}" FontSize="11" Foreground="#9B2C20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ReasonText"
                               Text="{DynamicResource CB_DefaultReason}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#141413"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- IP 对比与说明 -->
            <Border Grid.Row="2"
                    Background="#FFFFFF"
                    BorderBrush="#E5E2DC"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12"
                    Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="{DynamicResource CB_ExpectedIpLabel}" FontSize="11" Foreground="#8C8980"/>
                            <TextBlock x:Name="ExpectedIpText" Text="--" FontSize="12.5" FontWeight="SemiBold" Foreground="#18794E" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="{DynamicResource CB_CurrentStatusLabel}" FontSize="11" Foreground="#8C8980"/>
                            <TextBlock x:Name="CurrentStatusText" Text="--" FontSize="12.5" FontWeight="SemiBold" Foreground="#C93B2B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="BehaviorDescText"
                               Text=""
                               FontSize="11.5"
                               Foreground="#5E5C56"
                               TextWrapping="Wrap"
                               LineHeight="17"/>
                </StackPanel>
            </Border>

            <!-- 底部操作按钮 -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnCooldownLock"
                        Grid.Column="0"
                        Style="{StaticResource SecondaryLightButtonStyle}"
                        Height="42"
                        FontSize="13"
                        Click="BtnCooldownLock_Click"
                        Content="取消（熔断保护 5 分钟）"/>

                <Button x:Name="BtnKillClaude"
                        Grid.Column="2"
                        Style="{StaticResource DangerClaudeButtonStyle}"
                        Height="42"
                        FontSize="13.5"
                        Click="BtnKillClaude_Click"
                        Content="确定（立即退出 · 5s）"/>
            </Grid>
        </Grid>
    </Border>
</Window>
